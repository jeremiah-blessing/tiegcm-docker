#
# Included makefile for GNU gfortran + OpenMPI on local Linux,
# with all native deps (gfortran, openmpi, hdf5-mpi, netcdf-fortran, esmf)
# installed into a conda-forge env. Expects CONDA_PREFIX to be set
# (i.e. the env is activated) when 'gmake' is invoked.
#
MPIF90 = mpifort
MPIRUN = mpirun

# -fdefault-real-8 = Intel's -r8 equivalent (promote default REAL to REAL(8))
# -DGNU            = compiler-ID cpp macro used by some source files
# -fallow-argument-mismatch needed for legacy MPI/netCDF calls with gfortran 10+
FFLAGS  = -fdefault-real-8 -fallow-argument-mismatch -DGNU
FFLAGS += -I$(CONDA_PREFIX)/include
LDFLAGS = -L$(CONDA_PREFIX)/lib -Wl,-rpath,$(CONDA_PREFIX)/lib
#
# DBGFLAGS are used by the Makefile only if the job script
# has "set debug = true"
#
DBGFLAGS  = -Og -fcheck=all,no-array-temps -fbacktrace
DBGFLAGS += -Wall -Wextra -Wpedantic
DBGFLAGS += -Wcharacter-truncation -Wconversion-extra
DBGFLAGS += -Wimplicit-interface -Wimplicit-procedure
#
# -ffpe-trap=invalid,zero,overflow traps all floating point exceptions.
# The model is not guaranteed not to crash if this option is set.
#
#DBGFLAGS += -ffpe-trap=invalid,zero,overflow
#
# Makefile will use OPTIM = -g if set debug=TRUE in job script.
OPTIM = -O2
HOST  = $(shell hostname)
#
# ESMF lib: location set by ESMFMKFILE env var (exported by setup-local.sh).
# The top-level Makefile does "include $(ESMFMKFILE)".
#
# Make machines.ini file for MPI execution:
#
prereq: machines.ini mpirun.command
machines.ini: export HN=$(HOST)
machines.ini: export NP=$(NPROC)
machines.ini: FORCE
	@echo "Making machines.ini.."
	@echo `hostname` > machines.ini
	@awk 'BEGIN{ for (i=2; i <= ENVIRON["NP"]; i++) print ENVIRON["HN"] }' >> machines.ini

mpirun.command: FORCE
	@echo "Making mpirun.command: MPIRUN=$(MPIRUN)"
	@echo $(MPIRUN) > mpirun.command

FORCE:
